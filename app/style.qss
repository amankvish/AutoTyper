/* AutoTyper v1.1 - Windows 11 Fluent Zinc Theme */

QWidget {
    font-family: "Segoe UI Variable", "Segoe UI", "Inter", "Arial", sans-serif;
    font-size: 13px;
    color: #e4e4e7; /* Zinc 200 */
}

/* Main Window & Dialogs */
QMainWindow, QDialog {
    background-color: #09090b; /* Zinc 950 */
}
QWidget {
    background-color: transparent;
}

/* Header Text */
QLabel#header_label {
    font-size: 24px;
    font-weight: 800;
    color: #0ea5e9; /* Sky 500 */
}
QLabel#brand_label {
    font-size: 11px;
    color: #71717a; /* Zinc 500 */
}
QLabel#accent_label {
    font-weight: 700;
    color: #0ea5e9;
}
QLabel#countdown_label {
    font-size: 24px;
    font-weight: 800;
    color: #0ea5e9;
}
QLabel#footer_hint {
    color: #71717a;
    font-size: 11px;
    margin-top: 10px;
}

/* Toolbar */
QToolBar {
    background-color: #18181b;
    border-bottom: 1px solid #27272a; /* Zinc 800 */
    padding: 6px;
}
QToolButton {
    background-color: transparent;
    border-radius: 6px;
    padding: 6px 12px;
    margin: 2px;
}
QToolButton:hover {
    background-color: #27272a; /* Zinc 800 */
}
QToolButton:pressed {
    background-color: #3f3f46; /* Zinc 700 */
}

/* Primary Action Button (Start) */
QPushButton#primary_action {
    background-color: #0ea5e9; /* Sky 500 */
    color: white;
    font-weight: 700;
    font-size: 14px;
    border-radius: 8px;
    padding: 10px 16px;
    border: none;
}
QPushButton#primary_action:hover {
    background-color: #0284c7; /* Sky 600 */
}
QPushButton#primary_action:pressed {
    background-color: #0369a1;
}

/* Danger Action Button (Stop) */
QPushButton#danger_action {
    background-color: #ef4444; /* Red 500 */
    color: white;
    font-weight: 700;
    font-size: 14px;
    border-radius: 8px;
    padding: 10px 16px;
    border: none;
}
QPushButton#danger_action:hover {
    background-color: #dc2626; /* Red 600 */
}
QPushButton#danger_action:pressed {
    background-color: #b91c1c;
}

/* Standard Buttons */
QPushButton {
    background-color: #27272a; /* Zinc 800 */
    border: 1px solid #3f3f46; /* Zinc 700 */
    border-radius: 6px;
    padding: 6px 16px;
    color: #e4e4e7;
}
QPushButton:hover {
    background-color: #3f3f46;
    border-color: #52525b; /* Zinc 600 */
}
QPushButton:pressed {
    background-color: #18181b;
}
QPushButton:disabled {
    background-color: #18181b;
    color: #52525b;
    border-color: #27272a;
}

/* Cards (Flat GroupBoxes) */
QGroupBox {
    background-color: #27272a; /* Zinc 800 */
    border: 1px solid #3f3f46; /* Zinc 700 - Visible border */
    border-radius: 8px;
    margin-top: 24px; /* Space for title */
    padding-top: 15px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #a1a1aa; /* Zinc 400 */
    font-weight: 600;
    font-size: 12px;
    left: 10px;
    top: 5px;
}

/* Inputs & ComboBoxes */
QLineEdit, QSpinBox, QComboBox {
    background-color: #18181b; /* Zinc 900 */
    border: 1px solid #3f3f46; /* Zinc 700 */
    border-radius: 4px;
    padding: 6px;
    color: #f4f4f5; /* Zinc 100 */
    border-bottom: 2px solid #3f3f46; /* Fluent bottom edge */
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #3f3f46;
    border-bottom: 2px solid #0ea5e9; /* Sky 500 Glow */
    background-color: #18181b;
}
QComboBox::drop-down {
    border-left: 1px solid transparent;
    width: 24px;
}
QComboBox::down-arrow {
    image: none; /* Native arrow if empty, or we let OS paint it. Often text rendering handles it better */
}
QComboBox QAbstractItemView {
    background-color: #27272a;
    border: 1px solid #3f3f46;
    selection-background-color: #0ea5e9;
    selection-color: white;
}

/* Editor */
QPlainTextEdit {
    background-color: #18181b; /* Zinc 900 */
    color: #f4f4f5;
    border: 1px solid #3f3f46;
    border-radius: 8px;
    padding: 8px; /* Slightly more padding */
    selection-background-color: #0284c7;
    selection-color: white;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 16px; /* Increased from 14px */
}
QPlainTextEdit:focus {
    border: 1px solid #3f3f46;
}

/* Scrollbars */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:vertical {
    background: #3f3f46;
    min-height: 20px;
    border-radius: 6px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background: #52525b;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:horizontal {
    background: #3f3f46;
    min-width: 20px;
    border-radius: 6px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover {
    background: #52525b;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* Status Bar */
QStatusBar {
    background-color: #18181b;
    color: #71717a; /* Zinc 500 */
    border-top: 1px solid #27272a;
}
QStatusBar QLabel {
    padding: 0 8px;
    font-weight: 500;
}

/* Sliders */
QSlider::groove:horizontal {
    border: 1px solid #3f3f46;
    height: 6px;
    background: #18181b;
    border-radius: 3px;
}
QSlider::sub-page:horizontal {
    background: #0ea5e9; /* Sky 500 */
    border-radius: 3px;
}
QSlider::add-page:horizontal {
    background: #18181b;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #e4e4e7;
    border: 1px solid #52525b;
    width: 14px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background: #ffffff;
}

/* CheckBoxes & RadioButtons */
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #52525b;
    background-color: #18181b;
}
QRadioButton::indicator {
    border-radius: 8px;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #0ea5e9;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #0ea5e9;
    border-color: #0ea5e9;
}
